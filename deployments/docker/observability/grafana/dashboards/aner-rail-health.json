{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "title": "Rails \u2014 Rail Performance & Health Dashboard",
  "uid": "aner-rail-health",
  "tags": [
    "aner",
    "rails",
    "health",
    "observability",
    "S2T1"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "rail_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(aner_rail_health_check_result, rail_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health Monitor Liveness",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Health Monitor \u00e2\u20ac\u201d Seconds Since Last Run",
      "description": "How many seconds since the health monitor last completed a cycle. Red if > 90s (alert threshold).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "time() - aner_rail_health_monitor_last_run_timestamp",
          "legendFormat": "seconds ago",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Health Monitor \u00e2\u20ac\u201d Last Run Time",
      "description": "Timestamp of the last successful health monitor run.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "aner_rail_health_monitor_last_run_timestamp * 1000",
          "legendFormat": "last run",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Current Rail Health Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Rail Health Status",
      "description": "Current health status per rail. Green = healthy (1), Red = unhealthy (0).",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNHEALTHY",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "aner_rail_health_check_result{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{ rail_id }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Health Check Metrics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "Health Check Result Over Time",
      "description": "Time series of health check results per rail. 1 = healthy, 0 = unhealthy.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_health_check_result{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{ rail_id }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Health Check Latency",
      "description": "Histogram of health check response times per rail.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(aner_rail_health_check_latency_seconds_sum{rail_id=~\"$rail_id\"}[5m]) / rate(aner_rail_health_check_latency_seconds_count{rail_id=~\"$rail_id\"}[5m])",
          "legendFormat": "{{ rail_id }} avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(aner_rail_health_check_latency_seconds_bucket{rail_id=~\"$rail_id\"}[5m]))",
          "legendFormat": "{{ rail_id }} p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Settlement Performance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Settlement Success Rate (%)",
      "description": "Percentage of submissions in the last hour that reached settled status, per rail. Green \u00e2\u2030\u00a5 95%, Amber \u00e2\u2030\u00a5 80%, Red < 80%.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_settlement_success_rate{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{ rail_id }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Settlement Time vs SLA (minutes)",
      "description": "Average settlement time in minutes over the last hour. Compare against the declared settlement_speed_minutes_p50 SLA.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_average_settlement_time_minutes{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{ rail_id }} actual",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Settlement Success Rate \u00e2\u20ac\u201d Current",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "gauge",
      "title": "Current Settlement Success Rate per Rail",
      "description": "Current settlement success rate gauge per rail with colour coding.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "showThresholdLabels": true
      },
      "targets": [
        {
          "expr": "aner_rail_settlement_success_rate{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{ rail_id }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Hourly Performance Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      }
    },
    {
      "type": "stat",
      "title": "Settlement Success Rate",
      "description": "Percentage of submitted legs that reached a settled status within settlement_speed_minutes_p99.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 75.0
              },
              {
                "color": "green",
                "value": 95.0
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "avg(aner_rail_settlement_success_rate{rail_id=~\"$rail_id\"})",
          "legendFormat": "Avg Settlement Rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Submission Success Rate",
      "description": "Percentage of submissions that received a submitted or pending response.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90.0
              },
              {
                "color": "green",
                "value": 98.0
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "avg(aner_rail_submission_success_rate{rail_id=~\"$rail_id\"})",
          "legendFormat": "Avg Submission Rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dispatcher Timeout Rate",
      "description": "Percentage of submissions that timed out at the dispatcher level.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.0
              },
              {
                "color": "red",
                "value": 5.0
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "avg(aner_rail_timeout_rate{rail_id=~\"$rail_id\"})",
          "legendFormat": "Avg Timeout Rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Submissions Attempted",
      "description": "Total leg submissions attempted in the latest hourly window.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(aner_rail_submission_count{rail_id=~\"$rail_id\"})",
          "legendFormat": "Submissions",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Hourly Trend Lines by Rail",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      }
    },
    {
      "type": "timeseries",
      "title": "Settlement Success Rate Trend (Hourly)",
      "description": "Hourly trend of settlement success rate per rail against p99 settlement threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_settlement_success_rate{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{rail_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Submission Success Rate & Count Trend (Hourly)",
      "description": "Hourly trend of submission count and submission success rate per rail.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_submission_success_rate{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{rail_id}} (rate %)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Settlement Latency (Average vs p95)",
      "description": "Hourly average and 95th percentile settlement times (in minutes) for settled legs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_average_settlement_time_minutes{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{rail_id}} (avg)",
          "refId": "A"
        },
        {
          "expr": "aner_rail_p95_settlement_time_minutes{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{rail_id}} (p95)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dispatcher Timeout Rate Trend (Hourly)",
      "description": "Hourly trend of dispatcher timeout percentage per rail.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "aner_rail_timeout_rate{rail_id=~\"$rail_id\"}",
          "legendFormat": "{{rail_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Failure Code Distribution",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 61
      }
    },
    {
      "type": "timeseries",
      "title": "Failures by Failure Code",
      "description": "Count of each failure code encountered during the hourly window.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "sum(aner_rail_failure_distribution_count{rail_id=~\"$rail_id\"}) by (rail_id, failure_code)",
          "legendFormat": "{{rail_id}} \u00e2\u20ac\u201d {{failure_code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
