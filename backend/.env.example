# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Business Platform"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────────────
# For Docker Compose use service name (postgres); for local dev use localhost
DATABASE_URL=postgresql+asyncpg://aner:aner@postgres:5432/aner_settlement
DATABASE_SYNC_URL=postgresql+psycopg2://aner:aner@postgres:5432/aner_settlement

# Read-only role for ledger GET endpoints (see migration b7e4c9a15d20). The app
# derives its connection URL from DATABASE_URL + these credentials; set
# DATABASE_RO_URL_OVERRIDE instead if the read replica lives on a different host.
#
# LEDGER_RO_DB_PASSWORD has no default and no example value on purpose: whatever
# is written here becomes the real password in every environment that copies
# this file. Generate one per environment (`openssl rand -hex 24`) and put it in
# the untracked backend/.env. Both `alembic upgrade head` and the application
# fail with an explicit message while it is blank.
LEDGER_RO_DB_USER=ledger_ro
LEDGER_RO_DB_PASSWORD=
DATABASE_RO_URL_OVERRIDE=

# Read-only roles for the two further schemas the idempotency audit query
# interface reads (see migration d4f2a9c7b118). One role per module rather than
# one role spanning three, so each credential can read exactly one module.
# Blank for the same reason as LEDGER_RO_DB_PASSWORD above; generate one per
# environment and per role.
SETTLEMENT_RO_DB_USER=settlement_ro
SETTLEMENT_RO_DB_PASSWORD=
DATABASE_SETTLEMENT_RO_URL_OVERRIDE=
AUDIT_RO_DB_USER=audit_ro
AUDIT_RO_DB_PASSWORD=
DATABASE_AUDIT_RO_URL_OVERRIDE=

# ── Integrity Check ──────────────────────────────────────────────────────────
INTEGRITY_CHECK_ENABLED=false
INTEGRITY_CHECK_INTERVAL_SECONDS=3600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# ── GCP Audit Storage Sink ───────────────────────────────────────────────────
# Path to GCP Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
AUDIT_BUCKET_NAME=your-audit-logs-bucket
# Email identity of the service account (optional if GOOGLE_APPLICATION_CREDENTIALS/GCP_SERVICE_ACCOUNT_KEY JSON file is provided, as it will be parsed automatically)
SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
LOG_SINK_LOGGER_NAME=posting-service-audit-sink

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aner-settlement-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Onboarding / Sumsub KYC ────────────────────────────────────────────────────
# Off by default → in-process MockIdentityProvider (no network, no credentials).
# Set SUMSUB_ENABLED=true with real sandbox credentials to use the live provider.
SUMSUB_ENABLED=false
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_WEBHOOK_SECRET=change-me-sumsub-webhook-secret

ONBOARDING_ENABLED_PROVIDERS=mock,mock_screening

# ── Ngrok ─────────────────────────────────────────────────────────────────────
# Paste your Ngrok authtoken here if using the dockerized ngrok service
NGROK_AUTHTOKEN=

